{
  "tauri": {
    "$schema": "https://tauri.app/v2/schema.json",
    "productName": "VOID P2P Messenger",
    "version": "0.1.0",
    "identifier": "com.void.p2pmessenger",
    "build": {
      "beforeDevCommand": "",
      "beforeBuildCommand": ""
    },
    "windows": [
      {
        "title": "VOID P2P Messenger",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.xpm",
        "icons/icon.icns"
      ],
      "resources": ["static/**/*"]
    }
  }
}